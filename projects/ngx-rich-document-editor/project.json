{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "ngx-rich-document-editor",
  "projectType": "library",
  "sourceRoot": "projects/ngx-rich-document-editor/src",
  "prefix": "lib",
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:ng-packagr",
      "options": {
        "project": "projects/ngx-rich-document-editor/ng-package.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "projects/ngx-rich-document-editor/tsconfig.lib.prod.json"
        },
        "development": {
          "tsConfig": "projects/ngx-rich-document-editor/tsconfig.lib.json"
        }
      },
      "defaultConfiguration": "production",
      "outputs": [
        "{workspaceRoot}/dist/ngx-rich-document-editor"
      ]
    },
    "analyze": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "npx source-map-explorer dist/ngx-rich-document-editor/fesm2022/ngx-rich-document-editor.mjs"
        ],
        "cwd": "."
      },
      "dependsOn": [
        {
          "target": "build",
          "projects": "self"
        }
      ]
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
